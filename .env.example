# Optional. Etherscan V2 multi-chain API key for higher rate limits.
# The app works without this key using the free tier + eth_getLogs fallback.
# Used by the Vite SPA (VITE_*) and the Node MCP server.
VITE_ETHERSCAN_API_KEY=

# --- RPC URLs ---
# WARNING: Any VITE_* variable is inlined into the browser bundle at build time
# and is visible to every visitor. Use keyless or IP-restricted endpoints here.
# Keep privileged / API-keyed provider URLs on the Node/MCP side (non-VITE_ names).

# ForteL2 Sepolia (chain 852) — defaults to Mac sequencer loopback.
# Production: set VITE_FORTEL2_SEPOLIA_RPC_URL to the public sequencer-read
# gateway (D38, first) and VITE_FORTEL2_SEPOLIA_READ_RPC_URL to the replica
# (fallback). A public URL needs CORS + TLS, and a REBUILD to take effect —
# not just a restart. See D32 / D38.
# VITE_FORTEL2_SEPOLIA_RPC_URL=http://127.0.0.1:9545
# VITE_FORTEL2_SEPOLIA_READ_RPC_URL=
# Node MCP can also use FORTEL2_SEPOLIA_RPC_URL / FORTEL2_SEPOLIA_READ_RPC_URL.

# Polygon Amoy — defaults to https://polygon-amoy.drpc.org.
# VITE_POLYGON_AMOY_RPC_URL=
# Node MCP can also use POLYGON_AMOY_RPC_URL.

# --- Node server / remote MCP (npm start) ---
# PORT=3000

# Bearer auth for Cursor / custom clients (≥16 chars). MCP disabled (503) if unset.
MCP_API_KEY=

# OAuth for Claude.ai / Cursor connectors (optional; requires MCP_API_KEY).
# MCP_PUBLIC_URL = public https ORIGIN only (no /mcp path).
# Good:  https://settlementos-explorer-ihgo.onrender.com
# Bad:   https://….onrender.com/mcp
# On Render, RENDER_EXTERNAL_URL is used if MCP_PUBLIC_URL is unset.
# Prefer static MCP_OAUTH_CLIENT_ID / SECRET in Claude Advanced settings.
# Dynamic Client Registration is OFF by default (set true only if needed).
# MCP_OAUTH_CLIENT_ID=
# MCP_OAUTH_CLIENT_SECRET=
# MCP_PUBLIC_URL=
# MCP_OAUTH_ALLOW_DCR=false
